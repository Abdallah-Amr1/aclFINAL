tus\", \"statusId\")]\nfor table in [\"constructor_results\", \"constructor_standings\"]:\n    FOREIGN_KEYS += [(table, \"raceId\", \"races\", \"raceId\"),\n                     (table, \"constructorId\", \"constructors\", \"constructorId\")]\nfor table in [\"driver_standings\", \"lap_times\", \"pit_stops\"]:\n    FOREIGN_KEYS += [(table, \"raceId\", \"races\", \"raceId\"),\n                     (table, \"driverId\", \"drivers\", \"driverId\")]\n\nfk_rows = []\nfor table, col, ref_table, ref_col in FOREIGN_KEYS:\n    values = clean[table][col]\n    n_missing = values.isna().sum()\n    n_orphans = (values.notna() & ~values.isin(clean[ref_table][ref_col])).sum()\n    fk_rows.append({\"link\": f\"{table}.{col} → {ref_table}.{ref_col}\", \"rows\": len(values),\n                    \"missing\": n_missing, \"orphans\": n_orphans,\n                    \"pass\": n_missing == 0 and n_orphans == 0})\nfk_check = pd.DataFrame(fk_rows)\n\nprint(\"Foreign keys:\", fk_check[\"pass\"].sum(), \"of\", len(fk_check), \"pass\")\ndisplay(fk_check)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-16T15:34:41.034579Z","iopub.execute_input":"2026-10-16T15:34:41.034834Z","iopub.status.idle":"2026-10-16T15:34:41.078301Z","shell.execute_reply.started":"2026-10-16T15:34:41.03481Z","shell.execute_reply":"2026-10-16T15:34:41.077437Z"}},"outputs":[{"name":"stdout","text":"Foreign keys: 23 of 23 pass\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"                                                 link    rows  missing  \\\n0                           races.year → seasons.year    1125        0   \n1                races.circuitId → circuits.circuitId    1125        0   \n2                    qualifying.raceId → races.raceId   10494        0   \n3              qualifying.driverId → drivers.driverId   10494        0   \n4   qualifying.constructorId → constructors.constr...   10494        0   \n5                sprint_results.raceId → races.raceId    